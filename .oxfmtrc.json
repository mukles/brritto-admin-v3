{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/globals.css",
    "functions": ["cva", "cn", "clsx", "twMerge"]
  },
  "ignorePatterns": [
    "package-lock.json",
    "public/mockServiceWorker.js",
    "src/app/router/route-tree.gen.ts",
    ".claude/**",
    "skills-lock.json"
  ]
}
